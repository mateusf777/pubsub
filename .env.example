# PUBSUB Server Configuration Example
# Copy this file to .env and customize for your environment

# Server Address
# The address and port the server will bind to
# Default: 0.0.0.0:9999
PUBSUB_ADDRESS=0.0.0.0:9999

# TLS Configuration (Optional)
# Uncomment and set these variables to enable TLS

# Server Certificate (required for TLS)
#PUBSUB_TLS_CERT=/path/to/server.crt

# Server Private Key (required for TLS)
#PUBSUB_TLS_KEY=/path/to/server.key

# Certificate Authority (optional, enables mTLS)
# When set, the server will require and verify client certificates
# This enables multi-tenancy based on client certificate serial numbers
#PUBSUB_TLS_CA=/path/to/ca.crt

# TLS Examples:
# 
# 1. Basic TLS (Server authentication only):
#    PUBSUB_TLS_CERT=./certs/server.crt
#    PUBSUB_TLS_KEY=./certs/server.key
#    PUBSUB_ADDRESS=0.0.0.0:9443
#
# 2. Mutual TLS (Client and server authentication):
#    PUBSUB_TLS_CERT=./certs/server.crt
#    PUBSUB_TLS_KEY=./certs/server.key
#    PUBSUB_TLS_CA=./certs/ca.crt
#    PUBSUB_ADDRESS=0.0.0.0:9443
#
# 3. No TLS (Insecure, for development only):
#    PUBSUB_ADDRESS=0.0.0.0:9999

# Client Configuration (for client applications)

# Client TLS Certificate (required when server uses mTLS)
#PUBSUB_TLS_CLIENT_CERT=/path/to/client.crt

# Client TLS Private Key (required when server uses mTLS)
#PUBSUB_TLS_CLIENT_KEY=/path/to/client.key

# Server CA Certificate (for client to verify server)
#PUBSUB_TLS_SERVER_CA=/path/to/server-ca.crt

# Connection Settings

# Idle timeout (not exposed via environment variables, configured in code)
# Default: 60 seconds

# Close timeout (not exposed via environment variables, configured in code)
# Default: 60 seconds

# Notes:
# - Never commit actual certificates or keys to version control
# - Use proper secret management in production (e.g., Vault, AWS Secrets Manager)
# - Rotate certificates regularly
# - Use strong key sizes (RSA 2048+ or ECC 256+)
# - Keep private keys secure with appropriate file permissions (chmod 600)
